# Development Environment Configuration

# Optional: Set custom output directory for development builds
# Leave unset to build to 'dist/' folder
# Uncomment and adjust based on your OS:

# Windows
# OUTPUT_DIR=%APPDATA%\Cider\Plugins\music-recommendations

# macOS
# OUTPUT_DIR=~/Library/Application Support/Cider/Plugins/music-recommendations

# Linux
# OUTPUT_DIR=~/.config/Cider/Plugins/music-recommendations
